# Copy to .env (gitignored) and replace with freshly rotated keys.
# Never commit this file's values and never paste real keys in chat.

# Attacker strategist - Groq free tier
GROQ_ATTACKER_KEY=paste_new_groq_attacker_key_here

# Defender analyst - Gemini free tier
GEMINI_DEFENDER_KEY=paste_new_gemini_defender_key_here

# Report writer - Groq free tier
GROQ_REPORT_KEY=paste_new_groq_report_key_here

# Optional shared fallbacks (per provider)
# GROQ_API_KEY=paste_shared_groq_key_here
# GEMINI_API_KEY=paste_shared_gemini_key_here

# Optional model overrides
# CHAOSARENA_ATTACKER_LLM_MODEL=openai/gpt-oss-20b
# CHAOSARENA_DEFENDER_LLM_MODEL=gemini-3.5-flash-lite
# CHAOSARENA_REPORT_LLM_MODEL=openai/gpt-oss-20b
